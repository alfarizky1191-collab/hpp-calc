# ==============================================================================
# HPP Manager — Production Environment Variables
# ==============================================================================
# Copy this file to .env.production.local (Vercel) or set as environment
# variables in your deployment platform.
#
# NEVER commit .env.production.local or any file containing real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — REQUIRED
# Dashboard: https://supabase.com/dashboard/project/<id>/settings/api
# ------------------------------------------------------------------------------

# Project URL (public — safe to expose in client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key (public — used by browser client, restricted by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key-here

# Service role key — SERVER ONLY. Never expose to client.
# Used only in server-side code that needs to bypass RLS (e.g. admin operations).
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key-here

# ------------------------------------------------------------------------------
# Application — REQUIRED
# ------------------------------------------------------------------------------

# Full URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://hpp-manager.yourdomain.com

# Node environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Optional: Vercel-specific (auto-set by Vercel, no action needed)
# ------------------------------------------------------------------------------
# VERCEL_URL=your-deployment.vercel.app
# VERCEL_ENV=production
